@{
    ViewData["Title"] = "Shop Our Store - Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Choose Any Product</h1>

<section class="row card-group">
    @foreach (var p in Model)
    {
        <div class="col-sm-6 col-lg-4 mb-3">
            <div class="card mb-4 text-center h-100">
                <div class="card-body">
                    <a class="h5" asp-controller="Shop" asp-action="Browse" asp-route-itemid="@p.Id">@p.Name</a>
                    @if (p.Photo != null) {
                         <img src="~/img/product-uploads/@p.Photo" alt="Product image for @p.Name" class="img-thumbnail" />
                    }
                    <h6>@String.Format("{0:c}", p.Price)</h6>

                    <form method="post" action="/Shop/AddToCart">
                        <div class="form-group mt-4">
                            <label class="control-label" for="Quantity">Quantity:</label>
                            <input class="form-control form-control-sm w-25" name="Quantity" id="Quantity" required min="1" max="99999" type="number" />
                            <button class="btn btn-primary mt-1">Add to Cart</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</section>